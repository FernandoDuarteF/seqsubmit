nextflow_process {

    name "Test Process GENERATEMANIFEST"
    script "../main.nf"
    process "GENERATEMANIFEST"

    tag "modules"
    tag "modules_"
    tag "generatemanifest"

    test("GENERATEMANIFEST completes with expected outputs") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/ERR4918394.fasta.gz", checkIfExists: true),
                    file("${moduleDir}/tests/data.csv", checkIfExists: true)
                ]
                input[1] = "PRJ12345"
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    path(process.out.versions[0]).yaml
                ).match() }
                //TODO nf-core: Add all required assertions to verify the test output.
                // See https://nf-co.re/docs/contributing/tutorials/nf-test_assertions for more information and examples.
            )
        }

    }

    test("GENERATEMANIFEST completes with expected outputs - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${moduleDir}/tests/ERR4918394.fasta.gz", checkIfExists: true),
                    file("${moduleDir}/tests/data.csv", checkIfExists: true)
                ]
                input[1] = "PRJ12345"
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }

    }

}
