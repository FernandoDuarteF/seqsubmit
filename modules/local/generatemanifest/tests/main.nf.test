nextflow_process {

    name "Test Process GENERATEMANIFEST"
    script "../main.nf"
    process "GENERATEMANIFEST"

    tag "modules"
    tag "modules_"
    tag "generatemanifest"

    test("GENERATEMANIFEST completes with expected outputs") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/seqsubmit/test_data/contigs.fasta.gz"),
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/seqsubmit/samplesheets/samplesheet_generatemanifest.csv")
                ]
                input[1] = "PRJ12345"
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }

    }

    test("GENERATEMANIFEST completes with expected outputs - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${params.pipelines_testdata_base_path}/seqsubmit/test_data/contigs.fasta.gz"),
                    file("${params.pipelines_testdata_base_path}/seqsubmit/samplesheets/samplesheet_generatemanifest.csv")
                ]
                input[1] = "PRJ12345"
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }

    }

}
